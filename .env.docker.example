# =============================================================================
# Variables d'environnement Docker — à recopier en `.env` à côté du
# docker-compose.yml sur le serveur de prod.
# =============================================================================

# Identité de l'application
APP_NAME="Tiqé Helpdesk"
APP_URL=https://tique.softara.tech

# Généré une fois avec : docker compose run --rm app php artisan key:generate --show
APP_KEY=

# Port exposé sur l'hôte (le reverse proxy Softara redirigera dessus).
# Garde 8080 si plusieurs apps coexistent sur la machine.
APP_PORT=8080

# Niveau de log
LOG_LEVEL=warning

# Base de données (interne au compose)
DB_DATABASE=tique_helpdesk
DB_USERNAME=tique
DB_PASSWORD=change-me-strong-password
DB_ROOT_PASSWORD=change-me-root-strong

# Lancer le seed `AnnuaireSeeder` + référentiels au premier boot (1 = oui, 0 = non).
# Repasse à 0 après le premier démarrage pour ne pas dupliquer.
RUN_SEEDERS=1

# Email (SMTP)
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@softara.tech
MAIL_FROM_NAME="Tiqé"
